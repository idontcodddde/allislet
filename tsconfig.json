{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "allislet": ["./src/index.ts"],
      "@config": ["./allislet.config.ts"]
    }
  },
  "include": [
    "src/**/*",
    "examples/**/*",
    "allislet.config.ts",
    "vite.config.ts",
    "vite.standalone.config.ts"
  ]
}
