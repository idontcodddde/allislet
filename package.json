{
  "name": "allislet",
  "type": "module",
  "bin": {
    "allislet": "./dist/cli/index.js"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "bun run dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck",
    "test": "bun run typecheck",
    "check": "bun run typecheck && bun run build",
    "ci": "bun run check",
    "release": "bun run ./scripts/release.ts",
    "release:dry-run": "bun run ./scripts/release.ts --dry-run",
    "release:prepare": "bun run ./scripts/release.ts --dry-run",
    "docs:dev": "npm --prefix docs run start",
    "docs:build": "npm --prefix docs run build",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@docusaurus/tsconfig": "^3.10.2",
    "@iconify/react": "^6.0.2",
    "@preact/signals": "^2.11.1",
    "preact": "^10.29.8"
  }
}
